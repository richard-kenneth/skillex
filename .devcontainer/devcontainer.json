{
  "name": "SkillEx",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "mounts": [
    "source=skillex-node-modules-${devcontainerId},target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],
  "containerEnv": {
    "npm_config_store_dir": "/home/node/.pnpm-store"
  },
  "onCreateCommand": "sudo chown -R node:node node_modules",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "forwardPorts": [3000, 3001, 5432, 6379, 8025, 9000, 9001, 7880],
  "portsAttributes": {
    "3000": {
      "label": "Web",
      "onAutoForward": "openPreview"
    },
    "3001": {
      "label": "API"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    },
    "6379": {
      "label": "Redis",
      "onAutoForward": "silent"
    },
    "8025": {
      "label": "Mailpit",
      "onAutoForward": "silent"
    },
    "9000": {
      "label": "SeaweedFS S3 API",
      "onAutoForward": "silent"
    },
    "9001": {
      "label": "SeaweedFS UI",
      "onAutoForward": "silent"
    },
    "7880": {
      "label": "LiveKit (optional)",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "Prisma.prisma",
        "bradlc.vscode-tailwindcss"
      ]
    }
  },
  "remoteUser": "node"
}
