# Host ports published by docker-compose.yml.
#
# `pnpm run setup` copies this file to `.env` at the repository root. Change a
# value only when the default port is already used by another program, then
# rerun `pnpm run setup` so the local URLs in apps/api/.env match.
#
# Core services are published on 127.0.0.1. LiveKit stays on all interfaces
# because device testing needs the LAN address.
#
# Credentials in docker-compose.yml are development-only.

POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SEAWEEDFS_S3_PORT=9000
SEAWEEDFS_UI_PORT=9001

# Optional video stack: docker compose --profile video up -d
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
