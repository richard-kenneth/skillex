# Runtime
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
CLIENT_BASE_URL=http://localhost:3000
INTERNAL_SECRET=replace-me
# Comma-separated extra origins allowed in development only.
# Example: DEV_EXTRA_ORIGINS="https://abc.ngrok-free.dev,http://192.168.1.20:8081"
DEV_EXTRA_ORIGINS=

# Database and cache (provided by docker-compose.yml)
DATABASE_URL="postgresql://skillex:skillex@localhost:5432/skillex?schema=public"
REDIS_URL="redis://localhost:6379"

# Auth
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-me
JWT_SECRET=

# OAuth providers (optional; leave both values of a pair empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Email
# auto: use Resend when RESEND_API_KEY is set, otherwise SMTP, otherwise
# Mailpit on localhost:1025 in development.
EMAIL_TRANSPORT=auto
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
ONBOARDING_EMAIL_FROM="SkillEx <dev@skillex.local>"

# Video conferencing (optional)
# Enable the local stack with: docker compose --profile video up -d
# Then set:
#   NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
#   LIVEKIT_API_KEY=devkey
#   LIVEKIT_API_SECRET=secret
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# File uploads (MinIO locally; Cloudflare R2 in production)
R2_ACCESS_KEY_ID=skillex
R2_SECRET_ACCESS_KEY=skillex-dev-secret
R2_BUCKET_NAME=skillex-uploads
R2_ENDPOINT=http://localhost:9000
R2_PUBLIC_URL=http://localhost:9000/skillex-uploads

# Payments (optional)
# Leave both empty to use the local mock in development. For Flutterwave test
# mode, use your test keys from the Flutterwave dashboard.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# Exchange rates (optional; transparent fallback rates are used when unset)
OER_APP_ID=

# Web push (optional; both keys are required when either is set)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# Product analytics (optional; both values are required when either is set)
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=

# Expo deep-link scheme, used for trusted auth origins.
# Must match the "scheme" value in apps/mobile/app.json.
EXPO_SCHEME=skil-ex

# Seed demo users, exchanges, reviews, and points data (never in production)
SEED_DEMO_DATA=true
