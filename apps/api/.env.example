NODE_ENV=

PORT=
API_BASE_URL=
CLIENT_BASE_URL=
INTERNAL_SECRET=

# Comma-separated extra origins allowed in development only
# Example: DEV_EXTRA_ORIGINS="https://abc.ngrok-free.dev,http://192.168.1.20:8081"
DEV_EXTRA_ORIGINS=

# DB
DATABASE_URL="postgresql://user:password@localhost:5432/skil_ex?schema=public"

# Auth
JWT_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Email Provider
ONBOARDING_EMAIL_FROM=
RESEND_API_KEY=

# Video Conferencing (LiveKit)
NEXT_PUBLIC_LIVEKIT_URL="wss://<subdomain>.livekit.cloud"
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# File Uploads
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
R2_PUBLIC_URL="https://<public-bucket-id>.r2.dev"

# Payments
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

#Exchange Rates
OER_APP_ID=

# Cache
REDIS_URL=

# Web Push VAPID Config
# The API reads VAPID_PUBLIC_KEY. The web app reads NEXT_PUBLIC_VAPID_PUBLIC_KEY
# from apps/web/.env, so both values must be the same key pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# Expo
EXPO_SCHEME=

# PostHog Analytics
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
