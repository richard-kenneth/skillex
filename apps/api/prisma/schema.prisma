generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String              @id @default(uuid())
  name                String?
  email               String              @unique
  emailVerified       Boolean             @default(false)
  image               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  bio                 String?
  pointsBalance       Int                 @default(0)
  accounts            Account[]
  receivedRequests    ExchangeRequest[]   @relation("Receiver")
  sentRequests        ExchangeRequest[]   @relation("Sender")
  receivedReviews     Review[]            @relation("Reviewee")
  givenReviews        Review[]            @relation("Reviewer")
  sessions            Session[]
  skills              UserSkill[]
  exchangesAsSender   Exchange[]          @relation("ExchangeSender")
  exchangesAsReceiver Exchange[]          @relation("ExchangeReceiver")
  pointsTransactions  PointsTransaction[]
  sentMessages        Message[]           @relation("MessageSender")
  receivedMessages    Message[]           @relation("MessageReceiver")
  proposedSlots       ProposedSlot[]      @relation("SlotProposer")
  recordingConsents   RecordingConsent[]  @relation("ConsentUser")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  skills    Skill[]
}

model Skill {
  id                 String            @id @default(uuid())
  name               String            @unique
  categoryId         String?
  createdAt          DateTime          @default(now())
  offeredExchanges   ExchangeRequest[] @relation("OfferedSkill")
  requestedExchanges ExchangeRequest[] @relation("RequestedSkill")
  taughtExchanges    Exchange[]        @relation("TaughtSkill")
  receivedExchanges  Exchange[]        @relation("ReceivedSkill")
  exchangeSessions   ExchangeSession[] @relation("SessionSkill")
  proposedSlots      ProposedSlot[]    @relation("SlotSkill")
  category           Category?         @relation(fields: [categoryId], references: [id])
  userSkills         UserSkill[]
}

model UserSkill {
  id              String    @id @default(uuid())
  userId          String
  skillId         String
  type            SkillType
  experienceLevel String?
  createdAt       DateTime  @default(now())
  skill           Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId, type])
}

model ExchangeRequest {
  id                     String         @id @default(uuid())
  senderId               String
  receiverId             String
  requestedSkillId       String
  offeredSkillId         String?
  status                 RequestStatus  @default(PENDING)
  pointsProposal         Int            @default(0)
  pointsPayerId          String?
  pointsProposedBy       String?
  requestedSkillSessions Int            @default(1)
  requestedSkillDuration Int            @default(60)
  offeredSkillSessions   Int            @default(1)
  offeredSkillDuration   Int            @default(60)
  senderAgreed           Boolean        @default(true)
  receiverAgreed         Boolean        @default(false)
  scheduledAt            DateTime?
  completedAt            DateTime?
  senderAvailability     Json?
  receiverAvailability   Json?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  offeredSkill           Skill?         @relation("OfferedSkill", fields: [offeredSkillId], references: [id])
  receiver               User           @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  requestedSkill         Skill          @relation("RequestedSkill", fields: [requestedSkillId], references: [id])
  sender                 User           @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  exchange               Exchange?
  messages               Message[]      @relation("RequestMessages")
  proposedSlots          ProposedSlot[]
}

model Exchange {
  id                     String         @id @default(uuid())
  requestId              String         @unique
  senderId               String
  receiverId             String
  taughtSkillId          String
  receivedSkillId        String?
  pointsAmount           Int            @default(0)
  pointsPayerId          String?
  escrowLocked           Boolean        @default(false)
  requestedSkillSessions Int            @default(1)
  requestedSkillDuration Int            @default(60)
  offeredSkillSessions   Int            @default(1)
  offeredSkillDuration   Int            @default(60)
  completedSessions      Int            @default(0)
  status                 ExchangeStatus @default(COMMITTED)
  senderCompleted        Boolean        @default(false)
  receiverCompleted      Boolean        @default(false)

  committedAt   DateTime          @default(now())
  completedAt   DateTime?
  request       ExchangeRequest   @relation(fields: [requestId], references: [id])
  sender        User              @relation("ExchangeSender", fields: [senderId], references: [id])
  receiver      User              @relation("ExchangeReceiver", fields: [receiverId], references: [id])
  taughtSkill   Skill             @relation("TaughtSkill", fields: [taughtSkillId], references: [id])
  receivedSkill Skill?            @relation("ReceivedSkill", fields: [receivedSkillId], references: [id])
  sessions      ExchangeSession[]
  messages      Message[]         @relation("ExchangeMessages")
  reviews       Review[]
}

model ExchangeSession {
  id                String             @id @default(uuid())
  exchangeId        String
  skillId           String
  scheduledAt       DateTime
  completedAt       DateTime?
  status            SessionStatus      @default(SCHEDULED)
  recordingUrl      String?
  recordingKey      String?
  recordingEgressId String?
  recordingStatus   RecordingStatus?
  exchange          Exchange           @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  skill             Skill              @relation("SessionSkill", fields: [skillId], references: [id])
  recordingConsents RecordingConsent[]
}

model RecordingConsent {
  id                String          @id @default(uuid())
  exchangeSessionId String
  userId            String
  consented         Boolean
  consentedAt       DateTime        @default(now())
  exchangeSession   ExchangeSession @relation(fields: [exchangeSessionId], references: [id], onDelete: Cascade)
  user              User            @relation("ConsentUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([exchangeSessionId, userId])
}

model ProposedSlot {
  id         String     @id @default(uuid())
  requestId  String
  proposerId String
  skillId    String
  dayOfWeek  Int // 0=Sun, 1=Mon, ... 6=Sat
  startTime  String // "14:00" (24h format)
  status     SlotStatus @default(PROPOSED)
  createdAt  DateTime   @default(now())

  request  ExchangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  proposer User            @relation("SlotProposer", fields: [proposerId], references: [id])
  skill    Skill           @relation("SlotSkill", fields: [skillId], references: [id])
}

model PointsTransaction {
  id          String            @id @default(uuid())
  userId      String
  amount      Int
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  referenceId String?
  description String?
  createdAt   DateTime          @default(now())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppConfig {
  id                      String   @id @default("singleton")
  purchaseFeePercentage   Float    @default(0.05)
  purchaseFeeFixed        Int      @default(100)
  withdrawalFeePercentage Float    @default(0.05)
  withdrawalFeeFixed      Int      @default(50)
  minWithdrawalAmount     Int      @default(100)
  updatedAt               DateTime @updatedAt
}


model Message {
  id                     String           @id @default(uuid())
  exchangeId             String?
  requestId              String?
  senderId               String
  receiverId             String
  messageKey             MessageKey
  pointsProposal         Int?
  pointsPayerId          String?
  requestedSkillSessions Int?
  requestedSkillDuration Int?
  offeredSkillSessions   Int?
  offeredSkillDuration   Int?
  createdAt              DateTime         @default(now())
  exchange               Exchange?        @relation("ExchangeMessages", fields: [exchangeId], references: [id], onDelete: Cascade)
  request                ExchangeRequest? @relation("RequestMessages", fields: [requestId], references: [id], onDelete: Cascade)
  sender                 User             @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver               User             @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Review {
  id         String      @id @default(uuid())
  reviewerId String
  revieweeId String
  exchangeId String
  rating     Int
  tags       ReviewTag[]
  createdAt  DateTime    @default(now())
  exchange   Exchange    @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  reviewee   User        @relation("Reviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewer   User        @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, exchangeId])
}

enum SkillType {
  OFFERING
  SEEKING
}

enum RequestStatus {
  PENDING
  REJECTED
  COMMITTED
  CANCELLED
}

enum ExchangeStatus {
  COMMITTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RecordingStatus {
  PENDING_CONSENT
  RECORDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

enum TransactionType {
  PURCHASE
  ESCROW_LOCK
  ESCROW_RELEASE
  PENALTY
  CONVERSION
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}


enum MessageKey {
  INTERESTED_IN_EXCHANGE
  PROPOSE_TERMS
  AGREE_TO_TERMS
  PROPOSE_SLOTS
  ACCEPT_SLOTS
  PROPOSE_SCHEDULE
  AVAILABLE_WEEKDAYS
  AVAILABLE_WEEKENDS
  NEED_MORE_TIME
  REQUEST_RESCHEDULE
  CONFIRM_SESSION
  SESSION_WENT_WELL
  SESSION_HAD_ISSUES
  READY_TO_COMPLETE
  THANKS_FOR_EXCHANGE
}

enum SlotStatus {
  PROPOSED
  ACCEPTED
  REJECTED
}

enum ReviewTag {
  GREAT_TEACHER
  PATIENT
  KNOWLEDGEABLE
  ON_TIME
  CLEAR_EXPLANATIONS
  GOOD_COMMUNICATOR
  WELL_PREPARED
  WOULD_EXCHANGE_AGAIN
  NEEDS_IMPROVEMENT
  UNRESPONSIVE
}
