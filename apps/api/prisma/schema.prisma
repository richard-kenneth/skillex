generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                   @id @default(uuid())
  name                 String?
  email                String                   @unique
  emailVerified        Boolean                  @default(false)
  image                String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  bio                  String?
  pointsBalance        Int                      @default(0)
  preferredCurrency    String?
  referralCode         String?                  @unique
  referredById         String?
  referredBy           User?                    @relation("UserReferrals", fields: [referredById], references: [id])
  referredUsers        User[]                   @relation("UserReferrals")
  referralsGiven       Referral[]               @relation("Referrer")
  referralsReceived    Referral[]               @relation("Referee")
  accounts             Account[]
  receivedRequests     ExchangeRequest[]        @relation("Receiver")
  sentRequests         ExchangeRequest[]        @relation("Sender")
  receivedReviews      Review[]                 @relation("Reviewee")
  givenReviews         Review[]                 @relation("Reviewer")
  sessions             Session[]
  skills               UserSkill[]
  exchangesAsSender    Exchange[]               @relation("ExchangeSender")
  exchangesAsReceiver  Exchange[]               @relation("ExchangeReceiver")
  pointsTransactions   PointsTransaction[]
  sentMessages         Message[]                @relation("MessageSender")
  receivedMessages     Message[]                @relation("MessageReceiver")
  proposedSlots        ProposedSlot[]           @relation("SlotProposer")
  recordingConsents    RecordingConsent[]       @relation("ConsentUser")
  sessionChatMessages  SessionChatMessage[]     @relation("SessionChatSender")
  exchangeChatMessages ExchangeChatMessage[]    @relation("ExchangeChatSender")
  chatReadReceipts     SessionChatReadReceipt[] @relation("ChatReadUser")
  recordingsPaid       SessionRecording[]       @relation("RecordingBilling")
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  emailNotifications   Boolean                  @default(true)
  inAppNotifications   Boolean                  @default(true)
  pushNotifications    Boolean                  @default(true)
}


model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  createdAt   DateTime @default(now())
  sponsorName String?
  sponsorLogo String?
  sponsorUrl  String?
  skills      Skill[]
}

model Skill {
  id                 String            @id @default(uuid())
  name               String            @unique
  categoryId         String?
  createdAt          DateTime          @default(now())
  offeredExchanges   ExchangeRequest[] @relation("OfferedSkill")
  requestedExchanges ExchangeRequest[] @relation("RequestedSkill")
  taughtExchanges    Exchange[]        @relation("TaughtSkill")
  receivedExchanges  Exchange[]        @relation("ReceivedSkill")
  exchangeSessions   ExchangeSession[] @relation("SessionSkill")
  proposedSlots      ProposedSlot[]    @relation("SlotSkill")
  category           Category?         @relation(fields: [categoryId], references: [id])
  userSkills         UserSkill[]
}

model UserSkill {
  id              String    @id @default(uuid())
  userId          String
  skillId         String
  type            SkillType
  experienceLevel String?
  createdAt       DateTime  @default(now())
  skill           Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId, type])
}

model ExchangeRequest {
  id                     String         @id @default(uuid())
  senderId               String
  receiverId             String
  requestedSkillId       String
  offeredSkillId         String?
  status                 RequestStatus  @default(PENDING)
  pointsProposal         Int            @default(0)
  pointsPayerId          String?
  pointsProposedBy       String?
  requestedSkillSessions Int            @default(1)
  requestedSkillDuration Int            @default(60)
  offeredSkillSessions   Int            @default(1)
  offeredSkillDuration   Int            @default(60)
  senderAgreed           Boolean        @default(true)
  receiverAgreed         Boolean        @default(false)
  scheduledAt            DateTime?
  completedAt            DateTime?
  senderAvailability     Json?
  receiverAvailability   Json?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  offeredSkill           Skill?         @relation("OfferedSkill", fields: [offeredSkillId], references: [id])
  receiver               User           @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  requestedSkill         Skill          @relation("RequestedSkill", fields: [requestedSkillId], references: [id])
  sender                 User           @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  exchange               Exchange?
  messages               Message[]      @relation("RequestMessages")
  proposedSlots          ProposedSlot[]
}

model Exchange {
  id                     String         @id @default(uuid())
  requestId              String         @unique
  senderId               String
  receiverId             String
  taughtSkillId          String
  receivedSkillId        String?
  pointsAmount           Int            @default(0)
  pointsPayerId          String?
  escrowLocked           Boolean        @default(false)
  requestedSkillSessions Int            @default(1)
  requestedSkillDuration Int            @default(60)
  offeredSkillSessions   Int            @default(1)
  offeredSkillDuration   Int            @default(60)
  completedSessions      Int            @default(0)
  status                 ExchangeStatus @default(COMMITTED)
  senderCompleted        Boolean        @default(false)
  receiverCompleted      Boolean        @default(false)

  committedAt   DateTime              @default(now())
  completedAt   DateTime?
  request       ExchangeRequest       @relation(fields: [requestId], references: [id])
  sender        User                  @relation("ExchangeSender", fields: [senderId], references: [id])
  receiver      User                  @relation("ExchangeReceiver", fields: [receiverId], references: [id])
  taughtSkill   Skill                 @relation("TaughtSkill", fields: [taughtSkillId], references: [id])
  receivedSkill Skill?                @relation("ReceivedSkill", fields: [receivedSkillId], references: [id])
  sessions      ExchangeSession[]
  messages      Message[]             @relation("ExchangeMessages")
  reviews       Review[]
  chatMessages  ExchangeChatMessage[]
}

model ExchangeSession {
  id                String                   @id @default(uuid())
  exchangeId        String
  skillId           String
  scheduledAt       DateTime
  completedAt       DateTime?
  duration          Int                      @default(60) // agreed duration in minutes
  status            SessionStatus            @default(SCHEDULED)
  exchange          Exchange                 @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  skill             Skill                    @relation("SessionSkill", fields: [skillId], references: [id])
  recordingConsents RecordingConsent[]
  chatMessages      SessionChatMessage[]
  recordings        SessionRecording[]
  chatReadReceipts  SessionChatReadReceipt[]
}

model SessionRecording {
  id                 String          @id @default(uuid())
  exchangeSessionId  String
  recordingKey       String?
  recordingEgressId  String?         @unique
  recordingStatus    RecordingStatus @default(RECORDING)
  recordingExpiresAt DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  exchangeSession    ExchangeSession @relation(fields: [exchangeSessionId], references: [id], onDelete: Cascade)
  billingUserId      String?
  billingUser        User?           @relation("RecordingBilling", fields: [billingUserId], references: [id])
  totalLockedPoints  Int             @default(0)
  totalChargedPoints Int             @default(0)
  recordingStartedAt DateTime?
}

model RecordingConsent {
  id                String          @id @default(uuid())
  exchangeSessionId String
  userId            String
  consented         Boolean
  consentedAt       DateTime        @default(now())
  exchangeSession   ExchangeSession @relation(fields: [exchangeSessionId], references: [id], onDelete: Cascade)
  user              User            @relation("ConsentUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([exchangeSessionId, userId])
}

model ProposedSlot {
  id         String     @id @default(uuid())
  requestId  String
  proposerId String
  skillId    String
  dayOfWeek  Int // 0=Sun, 1=Mon, ... 6=Sat
  startTime  String // "14:00" (24h format)
  status     SlotStatus @default(PROPOSED)
  createdAt  DateTime   @default(now())

  request  ExchangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  proposer User            @relation("SlotProposer", fields: [proposerId], references: [id])
  skill    Skill           @relation("SlotSkill", fields: [skillId], references: [id])
}

model SessionChatMessage {
  id                String          @id @default(uuid())
  exchangeSessionId String
  senderId          String
  message           String
  timestamp         DateTime        @default(now())
  exchangeSession   ExchangeSession @relation(fields: [exchangeSessionId], references: [id], onDelete: Cascade)
  sender            User            @relation("SessionChatSender", fields: [senderId], references: [id], onDelete: Cascade)
}

model SessionChatReadReceipt {
  id                String          @id @default(uuid())
  exchangeSessionId String
  userId            String
  lastReadAt        DateTime        @default(now())
  exchangeSession   ExchangeSession @relation(fields: [exchangeSessionId], references: [id], onDelete: Cascade)
  user              User            @relation("ChatReadUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([exchangeSessionId, userId])
}

model ExchangeChatMessage {
  id         String   @id @default(uuid())
  exchangeId String
  senderId   String
  content    String? // text message
  fileKey    String? // R2 storage key
  fileName   String? // original file name
  fileType   String? // MIME type
  createdAt  DateTime @default(now())
  exchange   Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  sender     User     @relation("ExchangeChatSender", fields: [senderId], references: [id], onDelete: Cascade)
}

model PointsTransaction {
  id           String            @id @default(uuid())
  userId       String
  amount       Int
  type         TransactionType
  status       TransactionStatus @default(PENDING)
  referenceId  String?
  description  String?
  fiatAmount   Float?
  fiatCurrency String?
  flwRef       String?
  createdAt    DateTime          @default(now())
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppConfig {
  id                       String   @id @default("singleton")
  exchangeCommissionRate   Float    @default(0.10)
  facilitationFee          Int      @default(5)
  withdrawalSpread         Float    @default(0.06)
  minWithdrawalPoints      Int      @default(200)
  referralRewardReferrer   Int      @default(200)
  referralRewardReferee    Int      @default(200)
  referralBonusPerExchange Int      @default(50)
  referralBonusCap         Int      @default(500)
  referralMonthlyCap       Int      @default(5000)
  recordingPointsPerMinute Int      @default(4)
  updatedAt                DateTime @updatedAt
}

model Referral {
  id               String         @id @default(uuid())
  referrerId       String
  refereeId        String
  status           ReferralStatus @default(PENDING)
  referrerRewarded Boolean        @default(false)
  refereeRewarded  Boolean        @default(false)
  bonusAwarded     Int            @default(0)
  createdAt        DateTime       @default(now())
  convertedAt      DateTime?
  referrer         User           @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee          User           @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@unique([referrerId, refereeId])
}

model Message {
  id                     String           @id @default(uuid())
  exchangeId             String?
  requestId              String?
  senderId               String
  receiverId             String
  messageKey             MessageKey
  pointsProposal         Int?
  pointsPayerId          String?
  requestedSkillSessions Int?
  requestedSkillDuration Int?
  offeredSkillSessions   Int?
  offeredSkillDuration   Int?
  createdAt              DateTime         @default(now())
  exchange               Exchange?        @relation("ExchangeMessages", fields: [exchangeId], references: [id], onDelete: Cascade)
  request                ExchangeRequest? @relation("RequestMessages", fields: [requestId], references: [id], onDelete: Cascade)
  sender                 User             @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver               User             @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Review {
  id         String      @id @default(uuid())
  reviewerId String
  revieweeId String
  exchangeId String
  rating     Int
  tags       ReviewTag[]
  createdAt  DateTime    @default(now())
  exchange   Exchange    @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  reviewee   User        @relation("Reviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewer   User        @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, exchangeId])
}

enum SkillType {
  OFFERING
  SEEKING
}

enum RequestStatus {
  PENDING
  REJECTED
  COMMITTED
  CANCELLED
}

enum ExchangeStatus {
  COMMITTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RecordingStatus {
  PENDING_CONSENT
  RECORDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

enum TransactionType {
  PURCHASE
  ESCROW_LOCK
  ESCROW_RELEASE
  EXCHANGE_COMMISSION
  FACILITATION_FEE
  PENALTY
  CONVERSION
  WITHDRAWAL
  REFERRAL_REWARD
  REFERRAL_BONUS
  RECORDING_FEE
}

enum ReferralStatus {
  PENDING
  CONVERTED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum MessageKey {
  INTERESTED_IN_EXCHANGE
  PROPOSE_TERMS
  AGREE_TO_TERMS
  PROPOSE_SLOTS
  ACCEPT_SLOTS
  PROPOSE_SCHEDULE
  AVAILABLE_WEEKDAYS
  AVAILABLE_WEEKENDS
  NEED_MORE_TIME
  REQUEST_RESCHEDULE
  CONFIRM_SESSION
  SESSION_WENT_WELL
  SESSION_HAD_ISSUES
  READY_TO_COMPLETE
  THANKS_FOR_EXCHANGE
}

enum SlotStatus {
  PROPOSED
  ACCEPTED
  REJECTED
}

enum ReviewTag {
  GREAT_TEACHER
  PATIENT
  KNOWLEDGEABLE
  ON_TIME
  CLEAR_EXPLANATIONS
  GOOD_COMMUNICATOR
  WELL_PREPARED
  WOULD_EXCHANGE_AGAIN
  NEEDS_IMPROVEMENT
  UNRESPONSIVE
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

