NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_CLIENT_SIDE_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_CLIENT_BASE_URL=http://localhost:3000

# Payments (optional). Without a public key, the points page uses the API's
# local mock in development. Flutterwave test-mode public keys start with
# FLWPUBK_TEST-.
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# Web Push VAPID Public Key (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# PostHog (optional; uses a reverse proxy at /ph to avoid ad-blockers)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=/ph

# Pre-launch mode — gates marketplace features behind Coming Soon
NEXT_PUBLIC_PRELAUNCH_MODE=false
