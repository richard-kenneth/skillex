{
  "name": "skillex",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Richard Kenneth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theskillex/skillex.git"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "setup": "node scripts/setup.mjs",
    "db:up": "node scripts/docker.mjs compose up -d --wait postgres redis mailpit seaweedfs && node scripts/docker.mjs compose run --rm storage-init",
    "db:down": "node scripts/docker.mjs compose down",
    "db:reset": "node scripts/docker.mjs compose down -v && pnpm db:up"
  },
  "devDependencies": {
    "turbo": "^2.9.6"
  }
}
