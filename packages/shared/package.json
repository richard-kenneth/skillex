{
  "name": "@skillex/shared",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "author": "Richard Kenneth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richard-kenneth/skillex.git",
    "directory": "packages/shared"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint \"src/**/*.ts\" \"index.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"index.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"index.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"index.ts\"",
    "test": "node -e \"console.log('No shared tests yet')\""
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.100.3"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
